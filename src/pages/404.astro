---
import Layout from '../layouts/Layout.astro';
import SmallContainer from '../components/SmallContainer.astro';
---

<Layout title="404 — Not Found">
	<SmallContainer>
		<h1 class="font-extrabold text-3xl dark:text-main-500 text-main-600 mb-4">
			<!-- Zap icon -->
			<svg xmlns="http://www.w3.org/2000/svg" width="32" height="32" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="inline mb-1 mr-2">
				<polygon points="13 2 3 14 12 14 11 22 21 10 12 10 13 2" />
			</svg>
			Error: 404
		</h1>
		<p>
			The page you are looking for does not exist.
		</p>
	</SmallContainer>
</Layout>
