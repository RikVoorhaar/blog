---
import Layout from '../layouts/Layout.astro';
import SmallContainer from '../components/SmallContainer.astro';
---

<Layout title="404 — Not Found">
	<SmallContainer>
		<h1
			class="font-extrabold text-4xl mb-4 flex items-center gap-3 tracking-tight"
			style="color: var(--color-accent-500);"
		>
			<!-- Zap icon -->
			<svg xmlns="http://www.w3.org/2000/svg" width="36" height="36" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
				<polygon points="13 2 3 14 12 14 11 22 21 10 12 10 13 2" />
			</svg>
			404
		</h1>
		<p class="mb-2" style="color: var(--text-muted);">
			The page you are looking for does not exist.
		</p>
		<a
			href="/"
			class="font-semibold transition-colors duration-150"
			style="color: var(--color-link-300);"
		>
			Go back home →
		</a>
	</SmallContainer>
</Layout>

<style>
	html.light a {
		color: var(--color-link-700);
	}
</style>
