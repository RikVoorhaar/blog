---
import '../styles/app.css';
import 'katex/dist/katex.min.css';
---

<html lang="en">
	<head>
		<meta charset="utf-8" />
		<link rel="icon" href="/favicon.ico" />
		<meta name="viewport" content="width=device-width, initial-scale=1" />
		<title>Rik Voorhaar</title>
	</head>
	<body>
		<div class="dark:text-white flex flex-col min-h-screen">
			<main class="flex-1 p-8">
				<h1 class="text-3xl font-extrabold text-main-600 dark:text-main-500">
					Rik Voorhaar
				</h1>
				<p class="mt-4">Astro scaffold — Phase 0 complete.</p>

				<!-- Tailwind 4 sanity check -->
				<div class="mt-8 space-y-4">
					<div class="p-4 rounded-lg bg-turbo-100 dark:bg-turbo-900 text-turbo-800 dark:text-turbo-200">
						Turbo palette: bg-turbo-100 / dark:bg-turbo-900
					</div>
					<div class="p-4 rounded-lg bg-puerto-rico-100 dark:bg-puerto-rico-900 text-puerto-rico-800 dark:text-puerto-rico-200">
						Puerto Rico palette: bg-puerto-rico-100 / dark:bg-puerto-rico-900
					</div>
					<div class="p-4 rounded-lg bg-secondary-100 dark:bg-secondary-900 text-secondary-800 dark:text-secondary-200">
						Secondary palette: bg-secondary-100 / dark:bg-secondary-900
					</div>
					<div class="prose dark:prose-invert">
						<p class="text-sm text-gray-500">Typography plugin: .prose test paragraph. Tailwind 4 phase 2.</p>
					</div>
				</div>
			</main>
		</div>
	</body>
</html>
