---
import { getCollection, render } from 'astro:content';
import BlogPostLayout from '../../layouts/BlogPostLayout.astro';
import PostCard from '../../components/PostCard.astro';
import Output from '../../components/markdown/Output.astro';
import Details from '../../components/markdown/Details.astro';
import A from '../../components/markdown/a.astro';
import Img from '../../components/markdown/img.astro';
import Blockquote from '../../components/markdown/blockquote.astro';
import ImgSmall from '../../components/markdown/ImgSmall.astro';

export async function getStaticPaths() {
	const posts = await getCollection('blog', ({ data }) => !data.draft);
	return posts.map((post) => ({
		params: { slug: post.id },
		props: { post },
	}));
}

const { post } = Astro.props;
const { Content } = await render(post);

// Resolve teaser image for OG meta (astro:assets)
const teaserImages = import.meta.glob<{ default: ImageMetadata }>(
	'../../assets/teasers/*.{png,jpg,jpeg,webp}',
	{ eager: true },
);
const teaserMeta = teaserImages[`../../assets/teasers/${post.data.teaser}`]?.default;
const ogImage = teaserMeta ? teaserMeta.src : `/blog/teasers/original/${post.data.teaser}`;

// Related posts: prefer category matches, then most recent, exclude self & drafts
const allPosts = await getCollection('blog', ({ data }) => !data.draft);
const currentCategories = new Set(post.data.categories);
const relatedPosts = allPosts
	.filter((p) => p.id !== post.id)
	.map((p) => ({
		post: p,
		score:
			p.data.categories.filter((c) => currentCategories.has(c)).length * 100 +
			(p.data.date.getTime() / 1e10),
	}))
	.sort((a, b) => b.score - a.score)
	.map((r) => r.post);
---

<BlogPostLayout
	title={post.data.title}
	description={post.data.excerpt}
	ogImage={ogImage}
	ogType="article"
>
	<Content
		components={{
			Output,
			Details,
			a: A,
			img: Img,
			blockquote: Blockquote,
			ImgSmall,
		}}
	/>
	<footer class="mt-12 pt-6 not-prose" style="border-top: 1px solid var(--border-subtle);">
		<p class="text-sm" style="color: var(--text-muted);">
			Published on {
				post.data.date.toLocaleDateString('en', {
					year: 'numeric',
					month: 'long',
					day: 'numeric',
				})
			}
		</p>
		<div class="flex flex-wrap gap-2 mt-2">
			{post.data.categories.map((cat) => (
				<span
					class="px-2 py-1 text-xs font-semibold uppercase tracking-wider"
					style="background-color: var(--color-accent-900); color: var(--color-accent-300); border-radius: var(--radius-full);"
				>
					{cat}
				</span>
			))}
		</div>
	</footer>

	{relatedPosts.length > 0 && (
		<section class="mt-16 not-prose">
			<h2
				class="text-2xl font-extrabold tracking-tight mb-6"
				style="color: var(--text-accent);"
			>
				Keep reading
			</h2>
			<div
				class="grid gap-5"
				style="grid-template-columns: repeat(auto-fill, minmax(16rem, 1fr));"
			>
				{relatedPosts.map((rp) => <PostCard post={rp} />)}
			</div>
		</section>
	)}
</BlogPostLayout>

<style>
	html.light footer span[style*="--color-accent-900"] {
		background-color: var(--color-accent-100) !important;
		color: var(--color-accent-700) !important;
	}
</style>
