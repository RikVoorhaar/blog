---
interface Sense {
	pos: string;
	definition_da: string;
	equivalents_en: string[];
	equivalents_nl: string[];
	label?: string | null;
}

interface Expression {
	da: string;
	en?: string | null;
	nl?: string | null;
}

interface Entry {
	lemma: string;
	senses: Sense[];
	expressions?: Expression[] | null;
}

interface Props {
	entry: Entry;
}

const { entry } = Astro.props;

const abbr: Record<string, string> = {
	NOUN: 'sb.',
	VERB: 'vb.',
	ADJ: 'adj.',
	ADV: 'adv.',
	NUM: 'talord',
	PRON: 'pron.',
	DET: 'artikel',
	ADP: 'præp.',
	CCONJ: 'konj.',
	SCONJ: 'konj.',
	PART: 'part.',
	INTJ: 'udråb',
};
const pos = (p: string) => abbr[p] ?? p;
const many = entry.senses.length > 1;
const expressions = entry.expressions ?? [];
---

<div class="dict-entry not-prose">
	<div class="dict-head">{entry.lemma}</div>

	{
		entry.senses.map((sense, i) => (
			<div class="dict-sense">
				<div class="dict-lead">
					{many && <b class="dict-num">{i + 1}.</b>}
					{sense.label && <b class="dict-label">{sense.label}</b>}
					<i class="dict-pos">{pos(sense.pos)}</i>
				</div>
				<p class="dict-def">{sense.definition_da}</p>
				<div class="dict-eqs">
					<div>
						<span class="dict-tag">EN:</span>
						{sense.equivalents_en.join(', ')}
					</div>
					<div>
						<span class="dict-tag">NL:</span>
						{sense.equivalents_nl.join(', ')}
					</div>
				</div>
			</div>
		))
	}

	{
		expressions.length > 0 && (
			<div class="dict-expr">
				<b>Udtryk:</b>{' '}
				{expressions.map((e, i) => (
					<>
						{i > 0 && '; '}
						<b>{e.da}</b>
						{(e.en || e.nl) && (
							<span class="dict-expr-gloss">
								{' '}
								({[e.en, e.nl].filter(Boolean).join(' / ')})
							</span>
						)}
					</>
				))}
			</div>
		)
	}
</div>

<style>
	.dict-entry {
		margin: 1.75rem 0;
		padding: 1rem 1.15rem 1.1rem;
		background: var(--surface-raised);
		border: 1px solid var(--border-subtle);
		border-radius: var(--radius-md);
		color: var(--text-primary);
		font-size: 0.95rem;
		line-height: 1.5;
	}

	.dict-head {
		font-size: 1.4rem;
		font-weight: 700;
		letter-spacing: -0.01em;
		margin-bottom: 0.35rem;
	}

	.dict-sense + .dict-sense {
		margin-top: 0.8rem;
		padding-top: 0.8rem;
		border-top: 1px solid var(--border-subtle);
	}

	.dict-lead {
		display: flex;
		flex-wrap: wrap;
		gap: 0.35rem;
		align-items: baseline;
		font-size: 0.9rem;
		color: var(--text-muted);
	}

	.dict-num,
	.dict-label {
		color: var(--text-primary);
		font-weight: 700;
	}

	.dict-pos {
		font-style: italic;
		color: var(--text-muted);
	}

	.dict-def {
		margin: 0.2rem 0 0.45rem;
	}

	.dict-eqs {
		display: grid;
		grid-template-columns: 1fr 1fr;
		gap: 0.2rem 1.25rem;
		font-size: 0.92rem;
	}

	.dict-tag {
		color: var(--text-heading-accent);
		font-weight: 700;
		text-decoration: underline;
		margin-right: 0.15rem;
	}

	.dict-expr {
		margin-top: 0.8rem;
		padding-top: 0.8rem;
		border-top: 1px solid var(--border-subtle);
		font-size: 0.92rem;
	}

	.dict-expr-gloss {
		color: var(--text-muted);
	}

	@media (max-width: 480px) {
		.dict-eqs {
			grid-template-columns: 1fr;
			gap: 0.15rem;
		}
	}
</style>
