---
// Contact item: icon + type label + value
export interface Props {
	type: string;
	content: string;
	href?: string;
}

const { type, content, href } = Astro.props;
---

<p class="mb-1 flex items-center gap-2">
	<span style="color: var(--color-teal-500);">
		<slot />
	</span>
	<span class="font-semibold" style="color: var(--color-accent-500);">{type}</span>:
	{href ? (
		<a
			href={href}
			class="font-semibold transition-colors duration-150"
			style="color: var(--color-link-300);"
		>
			{content}
		</a>
	) : (
		<span>{content}</span>
	)}
</p>

<style>
	html.light a {
		color: var(--color-link-700);
	}
</style>
