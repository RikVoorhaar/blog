---
// Publication entry with collapsible "More info" toggle
import Date from './Date.astro';

export interface Props {
	date: string;
	title: string;
	url: string;
	published?: string;
	coauthors?: string[];
	info?: string;
}

const { date, title, url, published, coauthors, info } = Astro.props;
const uid = title.replace(/[^a-zA-Z0-9]/g, '-').toLowerCase();
---

<Date start={date} /><br />
<p class="pl-4">
	<a class="text-lg text-main-700 dark:text-main-500 font-bold pr-2" href={url}>{title}</a>
	{published && (
		<br />
	)}
	{published && (
		<span class="mb-0">
			<svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="inline mr-1 dark:text-green-500 text-green-600"><path d="M15 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V7Z" /><path d="M14 2v4a2 2 0 0 0 2 2h4" /><path d="M10 9H8" /><path d="M16 13H8" /><path d="M16 17H8" /></svg>
			published in <span class="font-semibold">{published}</span>
		</span>
	)}
	{coauthors && coauthors.length > 0 && (
		<br />
	)}
	{coauthors && coauthors.length > 0 && (
		<span>
			<svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="inline mr-1 dark:text-green-500 text-green-600"><path d="M21.42 10.922a1 1 0 0 0-.019-1.838L12.83 5.18a2 2 0 0 0-1.66 0L2.6 9.08a1 1 0 0 0 0 1.832l8.57 3.908a2 2 0 0 0 1.66 0z" /><path d="M22 10v6" /><path d="M6 12.5V16a6 3 0 0 0 12 0v-3.5" /></svg>
			joined work with {coauthors.map((c, i) => (<>{i > 0 && ' and '}<span class="font-semibold">{c}</span></>))}
		</span>
	)}
	{info && (
		<div>
			<button
				id={`btn-${uid}`}
				class="flex align-top flex-auto italic font-semibold
					dark:hover:text-green-500 hover:text-green-600 transition-colors duration-500 cursor-pointer border-0 bg-transparent text-inherit p-0"
			>
				<span id={`chevron-${uid}`} class="inline-block transition-transform px-1 pl-0 my-1 rotate-90">
					<svg xmlns="http://www.w3.org/2000/svg" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="m9 18 6-6-6-6" /></svg>
				</span>
				More info
			</button>
			<div
				id={`info-${uid}`}
				class="border-l-2 border-l-main-700 dark:border-l-main-500 pl-2 ml-2 my-0 py-0 hidden"
				set:html={info}
			>
			</div>
		</div>
	)}
</p>

{info && (
	<script>
		(() => {
			const btn = document.getElementById('btn-{uid}');
			const infoEl = document.getElementById('info-{uid}');
			const chevron = document.getElementById('chevron-{uid}');
			if (btn && infoEl && chevron) {
				btn.addEventListener('click', () => {
					const hidden = infoEl.classList.toggle('hidden');
					chevron.style.transform = hidden ? 'rotate(90deg)' : 'rotate(0deg)';
				});
			}
		})();
	</script>
)}
