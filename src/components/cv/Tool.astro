---
// Tool category: icon + title + tool list
import CvIcon from './CvIcon.astro';

export interface Props {
	title: string;
	icon?: string;
	tools: string[];
}

const { title, icon, tools } = Astro.props;
---

<div class="mt-2 mb-3">
	<span class="text-lg font-bold" style="color: var(--text-accent);">{title}</span>
	<div class="flex items-center pl-4 flex-wrap">
		<span style="color: var(--color-teal-500);">
			<CvIcon name={icon} />
		</span>
		{tools.map((tool) => <span class="pl-2 font-semibold" style="color: var(--text-primary);">{tool}</span>)}
	</div>
</div>
