---
import Date from './Date.astro';
import ExperienceBulletpoint from './ExperienceBulletpoint.astro';

export interface Props {
	position: string;
	employer: string;
	image: string;
	date_start: string;
	date_end: string;
	bullets: string[];
	first?: boolean;
}

const { position, employer, image, date_start, date_end, bullets, first = false } = Astro.props;
---

<div class={`flex flex-col md:flex-row mb-6 pt-4 ${first ? '' : 'border-t'}`} style={first ? undefined : 'border-color: var(--border-subtle);'}>
	<div class="w-20 mr-0 md:mr-6 flex-shrink-0 pb-0">
		<img src={image} alt={employer} class="w-full mb-0 h-auto" />
	</div>
	<div class="flex-grow">
		<h3 class="!mt-0 text-lg font-bold" style="color: var(--text-primary);">
			{employer}<span class="ml-4 font-normal" style="color: var(--text-muted);">{position}</span>
		</h3>
		<Date start={date_start} end={date_end} />
	</div>
</div>
{bullets.map((b) => <ExperienceBulletpoint>{b}</ExperienceBulletpoint>)}
