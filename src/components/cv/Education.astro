---
import Date from './Date.astro';

interface Entry {
	title: string;
	university: string;
	note?: string;
}

export interface Props {
	date_start: string;
	date_end?: string;
	entries: Entry[];
}

const { date_start, date_end, entries } = Astro.props;
---

<div class="mb-2">
	<Date start={date_start} end={date_end} />
	{entries.map((entry, i) => (
		<div>
			{i > 0 && <br />}
			<span class="text-lg font-bold pr-2 pl-4" style="color: var(--text-accent);">{entry.title}</span>
			<span class="mx-1" style="color: var(--text-muted);">|</span>
			<span class="font-semibold pl-2" style="color: var(--text-primary);">{entry.university}</span>
			{entry.note && <span class="italic" style="color: var(--text-muted);" set:html={' (' + entry.note + ')'}></span>}
		</div>
	))}
</div>
