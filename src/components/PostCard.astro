---
import type { CollectionEntry } from 'astro:content';

interface Props {
	post: CollectionEntry<'blog'>;
}

const { post } = Astro.props;
const teaserSrc = `/blog/teasers/original/${post.data.teaser}`;
const date = post.data.date;
const day = date.getDate();
const month = new Intl.DateTimeFormat('en', { month: 'long' }).format(date);
const year = date.getFullYear();
const ordinal = (d: number): string => {
	if (d > 3 && d < 21) return 'th';
	switch (d % 10) {
		case 1: return 'st';
		case 2: return 'nd';
		case 3: return 'rd';
		default: return 'th';
	}
};
---

<div
	class="group flex flex-col h-full transition-all duration-250"
	style="background-color: var(--surface-raised); border-radius: var(--radius-lg);"
>
	<!-- Teaser image -->
	<a href={`/blog/${post.id}`} class="overflow-hidden" style="border-radius: var(--radius-md) var(--radius-md) 0 0;">
		<div class="aspect-[16/10] overflow-hidden" style="border-radius: var(--radius-md) var(--radius-md) 0 0;">
			<img
				src={teaserSrc}
				alt={`Teaser for ${post.data.title}`}
				loading="lazy"
				class="w-full h-full object-cover transition-transform duration-300 group-hover:scale-105"
				style="border-radius: var(--radius-md) var(--radius-md) 0 0;"
			/>
		</div>
	</a>

	<!-- Content -->
	<div class="flex flex-col flex-1 p-4 gap-2">
		<!-- Title -->
		<a
			href={`/blog/${post.id}`}
			class="text-xl font-extrabold leading-tight transition-colors duration-150 tracking-tight"
			style="color: var(--color-accent-500);"
		>
			{post.data.title}
		</a>

		<!-- Date -->
		<p class="text-sm" style="color: var(--text-muted);">
			{day}{ordinal(day)} of {month}, {year}
		</p>

		<!-- Excerpt with teal left rule -->
		<p
			class="flex-1 pl-3 my-1 leading-snug line-clamp-3 text-sm"
			style="border-left: 2px solid var(--color-teal-500); color: var(--text-primary);"
		>
			{post.data.excerpt}
		</p>

		<!-- Read more -->
		<a
			href={`/blog/${post.id}`}
			class="text-sm font-medium transition-colors duration-150"
			style="color: var(--color-link-300);"
		>
			read more →
		</a>

		<!-- Category chips -->
		<div class="flex flex-wrap gap-1.5 mt-1">
			{post.data.categories.map((cat) => (
				<span
					class="px-2 py-0.5 text-xs font-semibold uppercase tracking-wider"
					style="background-color: var(--color-accent-900); color: var(--color-accent-300); border-radius: var(--radius-full);"
				>
					{cat}
				</span>
			))}
		</div>
	</div>
</div>

<style>
	.duration-250 { transition-duration: 250ms; }
	html.light .group span[style*="--color-accent-900"] {
		background-color: var(--color-accent-100) !important;
		color: var(--color-accent-700) !important;
	}
</style>
